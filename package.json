{
  "name": "greyzone.ofc",
  "version": "1.0.0",
  "private": true,
  "description": "GREYZONE studio marketing site",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "npx --yes tsx scripts/validate-content.ts",
    "validate:routes": "npx --yes tsx scripts/validate-routes.ts",
    "validate:assets": "npx --yes tsx scripts/validate-assets.ts",
    "validate": "npm run validate:content && npm run validate:routes && npm run validate:assets",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:e2e:smoke": "npm run build && playwright test e2e/smoke.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyzone-ofc/greyzone.ofc.git"
  },
  "license": "ISC",
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
